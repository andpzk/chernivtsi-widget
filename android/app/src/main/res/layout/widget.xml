<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/chart"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@string/loading" />
    <TextView android:id="@+id/loading"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:background="@drawable/widget_surface"
        android:textColor="#EDF2F6" android:textSize="13sp" android:text="@string/loading" />
</FrameLayout>
